# jarlore-be configuration. Names and safe local examples only: never commit real values.
# Cloud Run: plain values as env vars, secrets from Secret Manager (docs/deployment/CLOUD_RUN.md).

# --- Runtime
APP_ENV=development              # development | test | production (production enforces https JWKS, a cursor secret, CORS origin)
PORT=8080                        # Cloud Run sets this; the server binds 0.0.0.0:$PORT
LOG_LEVEL=info                   # debug | info | warn | error (JSON logs, Cloud Logging field names)
REQUEST_TIMEOUT=15s              # per-request deadline
FRONTEND_ORIGIN=http://localhost:3000   # comma-separated CORS allow-list (browser calls only)

# --- Database (Neon PostgreSQL)
# Runtime: the POOLED connection string (host contains -pooler), with the restricted API role.
DATABASE_URL=postgres://jarlore_api:CHANGE_ME@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Migrations only (cmd/migrate): the DIRECT connection string (no -pooler), with the owner role.
DIRECT_DATABASE_URL=postgres://neondb_owner:CHANGE_ME@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
DB_MAX_CONNS=4                   # per instance; x Cloud Run max instances = most connections the API opens
DB_QUERY_EXEC_MODE=cache_statement   # cache_statement (Neon PgBouncer supports protocol-level prepared statements) | exec (fallback)

# --- Auth (Neon Auth / Managed Better Auth; the API only verifies tokens)
# NEON_AUTH_BASE_URL is shown in the Neon Console (Auth). Tokens are EdDSA and
# both iss and aud are the ORIGIN of that URL (scheme + host, no path).
AUTH_JWKS_URL=https://ep-example.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
AUTH_ISSUER=https://ep-example.neonauth.ap-southeast-1.aws.neon.tech
# AUTH_AUDIENCE=                 # defaults to AUTH_ISSUER
# Local development: run `go run ./cmd/devauth` and use
#   AUTH_JWKS_URL=http://127.0.0.1:9999/.well-known/jwks.json
#   AUTH_ISSUER=http://127.0.0.1:9999

# --- Pagination
CURSOR_SIGNING_SECRET=           # 32+ random bytes in production (openssl rand -base64 48)

# --- Plans (billing is not implemented yet)
BILLING_BETA_PRO_FOR_ALL=false   # true gives every user Pro limits (closed beta)

# --- Tests only
# JARLORE_TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres?sslmode=disable
# JARLORE_TEST_EXEC_MODE=exec
